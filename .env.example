# URL canónica del sitio (sin slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo visible en el sitio
NEXT_PUBLIC_CONTACT_EMAIL=hello@reallygreatsite.com

# SMTP — configure en Vercel o cPanel; nunca confirme secretos en Git
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GÜATSART <no-reply@example.com>"
CONTACT_TO=hello@reallygreatsite.com
